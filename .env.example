# Copy to .env and fill in. Never commit .env.

# Instagram account used by `ig login` (and for automatic login before actions).
IG_USERNAME=
IG_PASSWORD=
# One-time two-factor code, only needed when the account has 2FA and you run non-interactively.
IG_TOTP_CODE=

# Phone to emulate. Run `ig devices` for the full list.
IG_DEVICE=iPhone 13
# true = no visible browser window (default). false = watch the browser (handy for debugging).
IG_HEADLESS=true
# HTTP(S) proxy for the browser, e.g. http://127.0.0.1:8080. Defaults to $HTTPS_PROXY; set "none" to disable.
IG_PROXY=
# Use a specific Chromium/Chrome binary instead of the one Playwright downloaded.
IG_CHROMIUM_PATH=
IG_LOCALE=en-US
IG_TIMEZONE=America/New_York

# Where the logged-in session (cookies + storage) is kept between runs.
IG_SESSION_FILE=.session/state.json
# Per-step timeout and the longer timeout used while uploads finish (milliseconds).
IG_TIMEOUT_MS=45000
IG_UPLOAD_TIMEOUT_MS=120000
# Save a screenshot + HTML after every step into debug/ (same as --debug).
IG_DEBUG=false
